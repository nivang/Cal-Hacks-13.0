# Copy to .env and fill in. Never commit .env.
# Coinbase Developer Platform keys: https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Seller wallet addresses (CDP accounts seller-a, seller-b, seller-c on Base Sepolia)
SELLER_A_ADDRESS=
SELLER_B_ADDRESS=
SELLER_C_ADDRESS=
# Supabase Postgres pooled connection string (Project Settings, Database, Connection string).
# Contains the database password. Server side only.
DATABASE_URL=
