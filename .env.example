# Copy to .env and fill in. Never commit .env.
# Make each secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Coinbase Developer Platform keys: https://portal.cdp.coinbase.com
# Production uses its own CDP project; never put production keys in a developer .env.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Which wallet signs payments (sentinel/wallets.py). cdp is the default and the only one built in.
SENTINEL_WALLET=cdp
# Escrow operator (sentinel/escrow.py): the CDP account that holds, captures and voids escrowed payments and pays
# their gas in Base Sepolia ETH. Default sentinel-operator; python -m demo.escrow_spike capture creates and funds it.
# SENTINEL_OPERATOR_ACCOUNT=sentinel-operator
# For the demo sellers only: the operator address they name in their escrow offers (else looked up from CDP).
# SENTINEL_OPERATOR_ADDRESS=
# Seller wallet addresses (CDP accounts seller-a, seller-b, seller-c on Base Sepolia)
SELLER_A_ADDRESS=
SELLER_B_ADDRESS=
SELLER_C_ADDRESS=
# Supabase Postgres pooled connection string (Project Settings, Database, Connection string).
# Contains the database password. Server side only.
DATABASE_URL=
# Public origin of the site, OAuth server and MCP endpoint, no path (https://sentinel.example.com; http://localhost:8000 locally).
PUBLIC_BASE_URL=
# Signs browser cookies, CSRF tokens and consent requests. 32+ characters, different from TOKEN_HASH_SECRET.
SESSION_SECRET=
# Hashes the sign in links, codes and tokens stored in the database. 32+ characters, different from SESSION_SECRET.
TOKEN_HASH_SECRET=
# Anthropic API key: Claude reads each task the agent starts and checks payments against it (sentinel/judge.py).
# Server side only. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional local XGBoost injection screen. Trusted training artifact directory, absolute or relative to repo root.
# Install .[ml], generate detector_manifest.json, and restart the server after changing this setting.
# SENTINEL_INJECTION_MODEL_DIR=artifacts/injection/<training-run>
# Resend API key for sign in emails. May stay empty on localhost only: links then print to the server's stderr.
RESEND_API_KEY=
# Sender for sign in emails, on a domain verified in Resend (Sentinel <signin@example.com>). Required with a key.
MAIL_FROM=
# Set to 1 only for the local demo (the test sellers run on localhost). Refused outside localhost.
SENTINEL_ALLOW_LOCAL_URLS=
# The paid service catalog find_services searches (x402 Bazaar discovery shape). No default: unset means no catalog.
# Locally, the test site (uvicorn test_site.app:app --port 4000) serves one here.
SENTINEL_DISCOVERY_URL=http://localhost:4000/test-site/discovery/resources
# Where python -m sentinel.mcp_server listens: the sign in site, OAuth and MCP (/mcp) all on this one host and port.
# PORT, when the host platform sets it, wins over SENTINEL_MCP_PORT.
SENTINEL_MCP_HOST=127.0.0.1
SENTINEL_MCP_PORT=8000
# Behind a reverse proxy: the proxy's address, so client IPs (and the per IP rate limits) are real. Never "*".
# FORWARDED_ALLOW_IPS=
# Ledger page (ledger_app.py): the owner's password, 12+ characters. Never give it to an agent.
SENTINEL_OWNER_PASSWORD=
# Apify API token for running Actors on your Apify credit (console.apify.com, Settings, API & Integrations). Server side only.
APIFY_TOKEN=
# Credit purchases share this token; server-wide safety ceilings in USD, in addition to each user's task limits.
APIFY_MAX_RUN_USD=1.00
APIFY_DAILY_BUDGET_USD=5.00
# Texting the agent over iMessage (sentinel/texting.py, texting_relay/). Shared with the relay, 24+ characters.
# Unset turns /texting/* and the account Texting page off.
SENTINEL_TEXTING_SECRET=
# Photon Spectrum Cloud project (app.photon.codes). Read by texting_relay only, never by Sentinel.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
